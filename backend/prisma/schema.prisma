generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  nome         String
  email        String   @unique
  cargo        String?
  perfil       Role     @default(COLABORADOR)
  fotoUrl      String?
  senhaHash    String
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  visitas      Visita[] @relation("ColaboradorVisitas")
  aprovadas    Visita[] @relation("AprovadorVisitas")
}

enum Role {
  ADMIN
  COLABORADOR
}

model Cliente {
  id          String   @id @default(cuid())
  nome        String
  codigo      String?
  observacao  String?
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  visitas     Visita[]
}

model Visita {
  id                 String    @id @default(cuid())
  colaboradorId      String
  clienteId          String
  dataVisita         DateTime
  observacao         String?
  status             Status    @default(RASCUNHO)
  motivoReprovacao   String?
  total              Decimal   @default(0) @db.Decimal(12, 2)
  criadoEm           DateTime  @default(now())
  enviadoEm          DateTime?
  aprovadoEm         DateTime?
  aprovadoPorId      String?
  colaborador        User      @relation("ColaboradorVisitas", fields: [colaboradorId], references: [id])
  cliente            Cliente   @relation(fields: [clienteId], references: [id])
  aprovadoPor        User?     @relation("AprovadorVisitas", fields: [aprovadoPorId], references: [id])
  despesas           Despesa[]

  @@index([colaboradorId])
  @@index([clienteId])
  @@index([status])
  @@index([dataVisita])
}

enum Status {
  RASCUNHO
  AGUARDANDO
  APROVADO
  REPROVADO
}

model Despesa {
  id             String    @id @default(cuid())
  visitaId       String
  categoria      String    @default("Uber")
  tipo           TipoDespesa
  valor          Decimal   @db.Decimal(12, 2)
  comprovanteUrl String?
  createdAt      DateTime  @default(now())
  visita         Visita    @relation(fields: [visitaId], references: [id], onDelete: Cascade)

  @@index([visitaId])
}

enum TipoDespesa {
  IDA
  VOLTA
  OUTRO
}
